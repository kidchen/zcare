# Copy to .env and fill in. Never commit .env.

# ---- AMap (高德开放平台 → 应用管理 → 添加Key → 服务平台: "Web服务") ----
AMAP_KEY=
CITY_NAME=呼和浩特
CITY_ADCODE=150100

# ---- WeCom (企业微信管理后台 → 应用管理 → 自建应用) ----
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# news (default): image-text cards, one tappable item per drama/place/route — works in WeChat too.
# text: plain text. markdown: WeCom app only. textcard: single cards (multi-item results go as news).
WECOM_MESSAGE_TYPE=news
# Callback (应用 → 接收消息 → 设置API接收). URL: https://<server>/wecom/webhook
# Token: any string up to 32 chars; EncodingAESKey: 43 chars (use the console's 随机获取)
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=

# ---- People (WeCom 通讯录 → 成员 → 账号) ----
FATHER_NAME=爸爸
FATHER_WECOM_USERID=
MOTHER_NAME=妈妈
MOTHER_WECOM_USERID=
# You — receives failure alerts (optional)
ADMIN_WECOM_USERID=

# ---- Places: GCJ-02 "lng,lat" (longitude first). Pick at https://lbs.amap.com/tools/picker ----
FATHER_HOME=
FATHER_WORK=
# Defaults to FATHER_HOME if empty
MOTHER_HOME=

# ---- Schedules (crontab; APScheduler: use day NAMES — numeric 0 = Monday!) ----
TIMEZONE=Asia/Shanghai
# Daily on purpose: the commute job checks the official calendar itself (调休 Saturdays included)
COMMUTE_CRON=30 7 * * *
OUTING_CRON=0 9 * * *
TV_CRON=0 19 * * fri
# Evening local-news digest (≤ DIGEST_MAX_ITEMS items, original articles) to both parents; empty = off
DIGEST_CRON=30 19 * * *
DIGEST_MAX_ITEMS=5
# Daily activity report to ADMIN_WECOM_USERID (last 24 h); empty = off
DAILY_REPORT_CRON=0 21 * * *

# ---- Commute ----
# Usual drive time in minutes; enables "slower than usual" hints. 0 = off.
COMMUTE_TYPICAL_MINUTES=0

# ---- Local news & warnings (no web search) ----
# Self-hosted we-mp-rss (WeChat Official Account articles, via YOUR 公众号 backend login).
# In docker-compose: http://we-mp-rss:8001
WEMP_RSS_URL=http://we-mp-rss:8001
# Optional image override if the default mirror (ghcr.nju.edu.cn) is slow from your server:
# WEMP_IMAGE=docker.1ms.run/rachelos/we-mp-rss:latest
# Optional: only these feeds (account ids from the we-mp-rss UI); empty = all subscribed accounts
WEMP_RSS_FEEDS=
# REQUIRED by docker-compose — generate each with: python3 -c "import secrets;print(secrets.token_urlsafe(18))"
# we-mp-rss admin UI password (user: admin)
WEMP_ADMIN_PASSWORD=
# we-mp-rss JWT secret and encryption key (its published defaults are public — never use them)
WEMP_SECRET_KEY=
WEMP_LIC_KEY=
# Shared secret for we-mp-rss → zcare login-expiry alerts (forwarded to ADMIN_WECOM_USERID)
WEMP_NOTIFY_TOKEN=
# Daily 03:30 cleanup: delete we-mp-rss articles older than this many days. Also how far back zcare looks
# for event announcements — raise to 14 if events announced 1-2 weeks ahead get missed.
WEMP_RETENTION_DAYS=7
# Official weather warnings from nmc.cn (中央气象台); set NMC_PROVINCE empty to disable
NMC_PROVINCE=内蒙古自治区
NMC_CITY_KEYWORD=呼和浩特

# ---- Outing ----
OUTING_MAX_TRANSFERS=1
OUTING_MAX_WALK_METERS=800
# Optional event scraping (all three required to enable)
OUTING_EVENT_URL=
OUTING_EVENT_ITEM_SELECTOR=
OUTING_EVENT_VENUE=

# ---- TV ----
TV_RECIPIENTS=father
# Each recommendation = TV_NEW_PICKS new hits (Douban 热门 TV_TRENDING_TAG) + classics (genre lists)
TV_NEW_PICKS=2
TV_TRENDING_TAG=国产剧
TV_CLASSIC_GENRES=历史,家庭,战争,悬疑,犯罪,戏曲
# Small ranking bonus when present
TV_PREFERRED_GENRES=历史,家庭,悬疑,犯罪,战争,剧情
# Never recommended (clearly unsuitable only — modern, suspense, light sci-fi are fine)
TV_EXCLUDED_GENRES=动画,恐怖,真人秀,脱口秀,儿童
# Dad's VIP: prefer dramas on this Douban vendor, and tell him to watch in this TV app
TV_PREFERRED_PLATFORM=爱奇艺
TV_APP_NAME=奇异果TV
TV_MIN_RATING=7.5
TV_PICKS=3
# Only if Douban starts returning 403/418: paste your browser's "bid=..." cookie
DOUBAN_COOKIE=

# ---- LLM family assistant ----
# Empty key = keyword commands only. When set, parents' chat messages are sent to the provider.
# bigmodel: 智谱 BigModel (https://bigmodel.cn → API Keys); default glm-4-flash-250414 (fast),
#           falls back to glm-4.7-flash when busy
# deepseek: https://platform.deepseek.com (prepaid); default model deepseek-flash
LLM_PROVIDER=bigmodel
LLM_API_KEY=
# Optional overrides; empty = provider default
LLM_MODEL=
# Tried when the primary is rate-limited/overloaded/slow; "none" to disable
LLM_FALLBACK_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
# Per-person cap to bound cost/abuse
LLM_MAX_MESSAGES_PER_HOUR=30
ASSISTANT_NAME=小暖

# ---- Runtime ----
# Public address of this server (WeCom/phones load drama posters from <PUBLIC_BASE_URL>/posters/...).
# Empty = cards without pictures.
PUBLIC_BASE_URL=http://<server-ip>:8000
# true = build messages and log them, never send
DRY_RUN=true
# Required for POST /jobs/{name}/run?dry_run=false. Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
STATE_FILE=data/state.json
LOG_LEVEL=INFO

# ---- Docker build (read by docker-compose.yml; optional) ----
# Default is the DaoCloud mirror; use python:3.13-slim if Docker Hub is reachable
# BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.13-slim
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
